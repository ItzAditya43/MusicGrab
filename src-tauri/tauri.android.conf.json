{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.musicgrab.mobile",
  "build": {
    "frontendDist": "../musicgrab/web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "externalBin": []
  }
}
