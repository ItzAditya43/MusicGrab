{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicGrab",
  "version": "1.0.0",
  "identifier": "app.musicgrab.desktop",
  "build": {
    "frontendDist": "../musicgrab/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MusicGrab",
        "url": "http://127.0.0.1:8765",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/musicgrab-web"],
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      }
    }
  }
}
